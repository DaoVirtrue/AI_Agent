        "---\n",
        "\n",
        "## 5. 源文档引用\n",
        "\n",
        "### 概念说明\n",
        "\n",
        "生产级 RAG 系统必须能够告诉用户答案的来源。\n",
        "使用 `RunnablePassthrough.assign()` 可以保留检索到的源文档，\n",
        "在最终输出中附加引用信息。"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "def format_sources_with_citation(docs: list[Document]) -> str:\n",
        "    \"\"\"格式化源文档引用。\"\"\"\n",
        "    if not docs:\n",
        "        return \"\"\n",
        "    \n",
        "    lines = [\"\\n\\n📚 参考文献:\"]\n",
        "    seen_sources = set()\n",
        "    ref_num = 0\n",
        "    for doc in docs:\n",
        "        source = doc.metadata.get(\"source\", \"未知\")\n",
        "        if source not in seen_sources:\n",
        "            ref_num += 1\n",
        "            seen_sources.add(source)\n",
        "            topic = doc.metadata.get(\"topic\", \"\")\n",
        "            lines.append(f\"  [{ref_num}] {source} ({topic})\")\n",
        "    return \"\\n\".join(lines)\n",
        "\n",
        "\n",
        "# 使用 assign() 保留源文档\n",
        "rag_with_sources_chain = (\n",
        "    RunnablePassthrough.assign(\n",
        "        # 检索并格式化上下文\n",
        "        context=lambda x: format_docs_for_conversation(\n",
        "            retriever.invoke(x[\"question\"])\n",
        "        ),\n",
        "        # 保留源文档供后续使用\n",
        "        source_docs=lambda x: retriever.invoke(x[\"question\"]),\n",
        "    )\n",
        "    | RunnablePassthrough.assign(\n",
        "        # 生成回答\n",
        "        answer=(\n",
        "            RunnableLambda(lambda x: {\n",
        "                \"context\": x[\"context\"],\n",
        "                \"question\": x[\"question\"],\n",
        "            })\n",
        "            | rag_prompt\n",
        "            | model\n",
        "            | StrOutputParser()\n",
        "        ),\n",
        "    )\n",
        "    | RunnablePassthrough.assign(\n",
        "        # 添加引用\n",
        "        final_answer=lambda x: x[\"answer\"] + format_sources_with_citation(x[\"source_docs\"]),\n",
        "    )\n",
        ")\n",
        "\n",
        "# 测试带引用的 RAG 链\n",
        "print(\"=== 带源引用的 RAG 链 ===\")\n",
        "result = rag_with_sources_chain.invoke({\"question\": \"什么是LangChain？\"})\n",
        "print(f\"\\n完整回答:\\n{result['final_answer']}\")\n",
        "print(f\"\\n检索到的源文档数: {len(result.get('source_docs', []))}\")\n",
        "for i, doc in enumerate(result.get('source_docs', []), 1):\n",
        "    print(f\"  [{i}] {doc.metadata.get('source', '未知')} - {doc.metadata.get('topic', '未知')}\")"
      ],
      "outputs": [],
      "execution_count": null
    },
