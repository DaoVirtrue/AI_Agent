      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# 带历史的 RAG 提示\n",
        "conversational_rag_prompt = ChatPromptTemplate.from_messages([\n",
        "    (\"system\", \"\"\"你是一个对话式文档助手。\n",
        "\n",
        "规则：\n",
        "1. 基于上下文和对话历史回答问题\n",
        "2. 上下文不足时，明确告知用户\n",
        "3. 引用具体文档来源\n",
        "4. 保持对话的连贯性\"\"\"),\n",
        "    MessagesPlaceholder(variable_name=\"chat_history\"),\n",
        "    (\"human\", \"上下文:\\n{context}\\n\\n问题: {question}\"),\n",
        "])\n",
        "\n",
        "\n",
        "def format_docs_for_conversation(docs: list[Document]) -> str:\n",
        "    \"\"\"格式化文档，带更详细的来源信息。\"\"\"\n",
        "    if not docs:\n",
        "        return \"暂无相关文档。\"\n",
        "    parts = []\n",
        "    for i, doc in enumerate(docs, 1):\n",
        "        source = doc.metadata.get(\"source\", \"未知\")\n",
        "        topic = doc.metadata.get(\"topic\", \"未知\")\n",
        "        parts.append(\n",
        "            f\"[来源{i}] 文件:{source} | 主题:{topic}\\n{doc.page_content}\"\n",
        "        )\n",
        "    return \"\\n\\n---\\n\\n\".join(parts)\n",
        "\n",
        "\n",
        "# 构建对话式 RAG 链\n",
        "# 注意：这里展示完整的 LCEL 模式\n",
        "\n",
        "# 首先定义聊天历史状态\n",
        "chat_history_store = []\n",
        "\n",
        "\n",
        "def build_conversational_rag_input(input_data: dict) -> dict:\n",
        "    \"\"\"为对话式 RAG 链构建完整输入。\n",
        "    \n",
        "    1. 上下文化问题 → 2. 检索 → 3. 格式化 → 4. 组合输入\n",
        "    \"\"\"\n",
        "    question = input_data[\"question\"]\n",
        "    chat_history = input_data.get(\"chat_history\", [])\n",
        "    \n",
        "    # 如果有历史，先上下文化问题\n",
        "    if chat_history:\n",
        "        contextualized = contextualize_q_chain.invoke({\n",
        "            \"chat_history\": chat_history,\n",
        "            \"question\": question,\n",
        "        })\n",
        "    else:\n",
        "        contextualized = question\n",
        "    \n",
        "    # 用上下文化后的问题检索\n",
        "    docs = retriever.invoke(contextualized)\n",
        "    context = format_docs_for_conversation(docs)\n",
        "    \n",
        "    return {\n",
        "        \"context\": context,\n",
        "        \"question\": question,\n",
        "        \"chat_history\": chat_history,\n",
        "        \"source_documents\": docs,\n",
        "    }\n",
        "\n",
        "\n",
        "conversational_rag_chain = (\n",
        "    RunnableLambda(build_conversational_rag_input)\n",
        "    | conversational_rag_prompt\n",
        "    | model\n",
        "    | StrOutputParser()\n",
        ")\n",
        "\n",
        "print(\"对话式 RAG 链已构建完成。\")"
      ],
      "outputs": [],
      "execution_count": null
