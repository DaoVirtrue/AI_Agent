        "### 2.2 LCEL 实现（第05阶段风格）\n",
        "\n",
        "使用 LCEL 声明式地构建相同的 RAG 管道："
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# ============================================\n",
        "# 第05阶段风格：LCEL 声明式实现\n",
        "# ============================================\n",
        "\n",
        "# 初始化组件\n",
        "retriever = MockRetriever(knowledge_base)\n",
        "model = MockChatModel()\n",
        "\n",
        "\n",
        "def format_docs(docs: list[Document]) -> str:\n",
        "    \"\"\"将检索到的文档格式化为上下文字符串。\"\"\"\n",
        "    if not docs:\n",
        "        return \"未找到相关文档。\"\n",
        "    formatted = []\n",
        "    for i, doc in enumerate(docs):\n",
        "        source = doc.metadata.get(\"source\", \"未知\")\n",
        "        formatted.append(\n",
        "            f\"<文档 id='{i+1}' 来源='{source}'>\\n{doc.page_content}\\n</文档>\"\n",
        "        )\n",
        "    return \"\\n\".join(formatted)\n",
        "\n",
        "\n",
        "# 创建 RAG 提示模板\n",
        "rag_prompt = ChatPromptTemplate.from_messages([\n",
        "    (\"system\", \"\"\"你是一个智能文档助手。请根据以下规则回答问题：\n",
        "1. 仅使用提供的上下文信息回答\n",
        "2. 如果上下文不足以回答问题，请明确说明\n",
        "3. 回答要简洁、准确、有依据\n",
        "4. 引用来源文档（文档id）来支撑你的回答\"\"\"),\n",
        "    (\"human\", \"上下文:\\n{context}\\n\\n问题: {question}\"),\n",
        "])\n",
        "\n",
        "# === LCEL RAG 链（核心：单条声明式表达式） ===\n",
        "lcel_rag_chain = (\n",
        "    {\n",
        "        \"context\": RunnableLambda(lambda q: retriever.invoke(q)) | RunnableLambda(format_docs),\n",
        "        \"question\": RunnablePassthrough(),\n",
        "    }\n",
        "    | rag_prompt\n",
        "    | model\n",
        "    | StrOutputParser()\n",
        ")\n",
        "\n",
        "# 统计代码行数（不包括组件初始化）\n",
        "lcel_code_lines = 15  # 核心 RAG 链定义部分\n",
        "print(f\"第05阶段 LCEL 实现代码行数: ~{lcel_code_lines} 行（核心链定义）\")\n",
        "print(f\"\\n特点:\")\n",
        "print(f\"  - 声明式：数据流一目了然\")\n",
        "print(f\"  - 自动管理中间结果\")\n",
        "print(f\"  - 高度模块化：每个组件可独立替换\")\n",
        "print(f\"  - 内置异步和流式支持\")\n",
        "print(f\"  - 无样板代码\")"
      ],
      "outputs": [],
      "execution_count": null
    },
