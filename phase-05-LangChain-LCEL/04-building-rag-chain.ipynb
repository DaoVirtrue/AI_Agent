        "## 7. 错误处理与降级\n",
        "\n",
        "### 在生产环境中，RAG 链可能遇到各种错误。展示如何使用 LCEL 的 fallback 机制。"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# 使用 LCEL 的 with_fallbacks() 实现优雅降级\n",
        "from langchain_core.runnables import RunnableLambda\n",
        "\n",
        "\n",
        "def safe_retriever(query: str) -> list[Document]:\n",
        "    \"\"\"安全的检索器：始终返回结果（即使是默认文档）。\"\"\"\n",
        "    try:\n",
        "        docs = retriever.invoke(query)\n",
        "        if not docs:\n",
        "            # 降级：返回通用文档\n",
        "            return [Document(\n",
        "                page_content=\"未找到与查询精确匹配的文档。请尝试其他关键词。\",\n",
        "                metadata={\"source\": \"fallback\", \"topic\": \"system\"}\n",
        "            )]\n",
        "        return docs\n",
        "    except Exception as e:\n",
        "        return [Document(\n",
        "            page_content=f\"检索时发生错误: {e}。请稍后重试。\",\n",
        "            metadata={\"source\": \"error\", \"topic\": \"system\"}\n",
        "        )]\n",
        "\n",
        "\n",
        "# 构建带错误处理的 RAG 链\n",
        "robust_rag_chain = (\n",
        "    RunnableLambda(lambda q: {\n",
        "        \"question\": q,\n",
        "        \"timestamp\": datetime.now().isoformat(),\n",
        "    })\n",
        "    | RunnablePassthrough.assign(\n",
        "        context=lambda x: format_docs(safe_retriever(x[\"question\"])),\n",
        "        docs_count=lambda x: len(safe_retriever(x[\"question\"])),\n",
        "    )\n",
        "    | RunnableLambda(lambda x: {\n",
        "        \"context\": x[\"context\"],\n",
        "        \"question\": x[\"question\"]\n",
        "    })\n",
        "    | rag_prompt\n",
        "    | model\n",
        "    | StrOutputParser()\n",
        ")\n",
        "\n",
        "# 测试正常和边缘情况\n",
        "edge_cases = [\n",
        "    \"什么是LangChain？\",  # 正常\n",
        "    \"量子计算与RAG的关系\",  # 可能没有精确匹配\n",
        "]\n",
        "\n",
        "print(\"=== 鲁棒 RAG 链测试 ===\")\n",
        "for query in edge_cases:\n",
        "    try:\n",
        "        answer = robust_rag_chain.invoke(query)\n",
        "        print(f\"\\n查询: {query}\")\n",
        "        print(f\"回答: {answer[:120]}...\")\n",
        "    except Exception as e:\n",
        "        print(f\"查询: {query} → 错误: {e}\")"
      ],
