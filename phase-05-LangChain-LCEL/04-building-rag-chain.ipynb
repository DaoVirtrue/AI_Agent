        "print(f\"  - 需要定义完整的类\")\n",
        "print(f\"  - 每个步骤需要独立的显式方法\")\n",
        "print(f\"  - 手动管理数据流和中间变量\")\n",
        "print(f\"  - 不够灵活：修改需要重写方法\")"
