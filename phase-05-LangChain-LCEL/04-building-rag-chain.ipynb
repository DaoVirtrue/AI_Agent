      "source": [
        "# 04 - 用 LCEL 构建 RAG 链\n",
        "\n",
        "## 学习目标\n",
        "\n",
        "1. 使用 LCEL 完整构建从文档到答案的 RAG 链\n",
        "2. 将 LCEL 实现与第03阶段的**自定义实现**进行对比\n",
        "3. 量化代码减少量：自定义实现 vs LCEL 的代码行数对比\n",
        "4. 可读性对比：并列展示两种实现\n",
        "5. 构建三种 RAG 变体：检索链、RAG 链、对话式 RAG\n",
        "6. 在输出中添加源文档引用\n",
        "\n",
        "## RAG 链的 LCEL 数据流\n",
        "\n",
        "```\n",
        "文档 → Loader → Splitter → Embeddings → VectorStore → Retriever\n",
        "                                                        ↓\n",
        "用户问题 ───────────────→ {context, question} → Prompt → LLM → Parser → 答案\n",
        "```\n",
        "\n",
        "关键洞察：在 LCEL 中，整个流程作为一条声明式管道表达。"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# 基础导入\n",
        "import sys\n",
        "sys.path.insert(0, '../..')\n",
        "\n",
        "import os\n",
        "import time\n",
        "from datetime import datetime\n",
        "from typing import Any\n",
        "\n",
        "# LangChain 核心\n",
        "from langchain_core.runnables import (\n",
        "    RunnablePassthrough,\n",
        "    RunnableLambda,\n",
        "    RunnableParallel,\n",
        ")\n",
        "from langchain_core.prompts import ChatPromptTemplate\n",
        "from langchain_core.prompts import MessagesPlaceholder\n",
        "from langchain_core.output_parsers import StrOutputParser\n",
        "from langchain_core.messages import AIMessage, HumanMessage, SystemMessage\n",
        "from langchain_core.documents import Document\n",
        "\n",
        "# Mock 组件\n",
        "from langchain_core.language_models import BaseChatModel\n",
        "from langchain_core.messages import BaseMessage\n",
        "from langchain_core.outputs import ChatResult, ChatGeneration\n",
        "from langchain_core.embeddings import Embeddings\n",
        "\n",
        "\n",
        "# ============================================\n",
        "# Mock 组件定义\n",
        "# ============================================\n",
        "\n",
        "class MockChatModel(BaseChatModel):\n",
        "    \"\"\"模拟 ChatModel，基于检索到的上下文生成回答。\n",
        "    \n",
        "    不进行实际 API 调用，根据收到的提示内容生成具有上下文的回复。\n",
        "    \"\"\"\n",
        "    \n",
        "    def _generate(\n",
        "        self,\n",
        "        messages: list[BaseMessage],\n",
        "        stop: list[str] | None = None,\n",
        "        run_manager: Any = None,\n",
        "        **kwargs: Any,\n",
        "    ) -> ChatResult:\n",
        "        # 提取所有消息内容\n",
        "        all_content = \"\\n\".join([\n",
        "            msg.content if hasattr(msg, 'content') else str(msg)\n",
        "            for msg in messages\n",
        "        ])\n",
        "        \n",
        "        # 模拟根据上下文生成回答\n",
        "        if \"上下文:\" in all_content or \"context\" in all_content.lower():\n",
        "            response = (\n",
        "                \"根据提供的文档，我可以给出以下回答：\\n\\n\"\n",
        "                \"文档中的信息表明，相关概念已在上下文中得到了充分的解释。\"\n",
        "                \"基于检索到的上下文片段，系统可以给出准确且有依据的答案。\"\n",
        "            )\n",
        "        else:\n",
        "            response = f\"[Mock] 收到 {len(messages)} 条消息，正在处理...\"\n",
        "        \n",
        "        return ChatResult(generations=[\n",
        "            ChatGeneration(message=AIMessage(content=response))\n",
        "        ])\n",
        "    \n",
        "    @property\n",
        "    def _llm_type(self) -> str:\n",
        "        return \"mock-chat-model\"\n",
        "\n",
        "\n",
        "class MockEmbeddings(Embeddings):\n",
        "    \"\"\"模拟嵌入模型，用于演示而无需 API 调用。\n",
        "    \n",
        "    使用基于字符哈希的确定性向量。\n",
        "    \"\"\"\n",
        "    \n",
        "    def embed_documents(self, texts: list[str]) -> list[list[float]]:\n",
        "        return [self._embed(text) for text in texts]\n",
        "    \n",
        "    def embed_query(self, text: str) -> list[float]:\n",
        "        return self._embed(text)\n",
        "    \n",
        "    def _embed(self, text: str) -> list[float]:\n",
        "        import hashlib\n",
        "        hash_bytes = hashlib.sha256(text.encode('utf-8')).digest()\n",
        "        vector = []\n",
        "        for i in range(64):\n",
        "            idx = i % len(hash_bytes)\n",
        "            vector.append((hash_bytes[idx] / 255.0) * 2 - 1)\n",
        "        return vector\n",
        "\n",
        "\n",
        "class MockRetriever:\n",
        "    \"\"\"模拟检索器，返回预设的文档列表。\n",
        "    \n",
        "    包装为 Runnable 兼容的接口。\n",
        "    \"\"\"\n",
        "    \n",
        "    def __init__(self, docs: list[Document]):\n",
        "        self.docs = docs\n",
        "    \n",
        "    def invoke(self, query: str, config=None) -> list[Document]:\n",
        "        \"\"\"返回与查询相关的文档。\n",
        "        \n",
        "        简单实现：检测查询中的关键词来过滤文档。\n",
        "        \"\"\"\n",
        "        query_lower = query.lower()\n",
        "        relevant = []\n",
        "        for doc in self.docs:\n",
        "            # 检查文档内容或元数据中是否包含查询关键词\n",
        "            doc_text = (doc.page_content + \" \" + str(doc.metadata)).lower()\n",
        "            # 简单评分：计算匹配的关键词数量\n",
        "            match_count = sum(\n",
        "                1 for word in query_lower.split()\n",
        "                if word in doc_text\n",
        "            )\n",
        "            if match_count > 0:\n",
        "                doc.metadata[\"relevance_score\"] = match_count / len(query_lower.split())\n",
        "                relevant.append(doc)\n",
        "        \n",
        "        # 按相关度排序，返回前 k 个\n",
        "        relevant.sort(key=lambda d: d.metadata.get(\"relevance_score\", 0), reverse=True)\n",
        "        return relevant[:3] if relevant else self.docs[:2]\n",
        "    \n",
        "    def get_relevant_documents(self, query: str) -> list[Document]:\n",
        "        return self.invoke(query)\n",
        "\n",
        "\n",
        "print(\"所有 Mock 组件已就绪。\")\n",
        "print(f\"  MockChatModel: 模拟 LLM 推理\")\n",
        "print(f\"  MockEmbeddings: 64维伪嵌入向量\")\n",
        "print(f\"  MockRetriever: 基于关键词匹配的检索\")"
      ],
      "outputs": [],
      "execution_count": null
    },
