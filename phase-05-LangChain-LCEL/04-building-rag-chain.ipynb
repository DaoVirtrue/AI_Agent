        "## 6. 高级模式：并行多渠道检索\n",
        "\n",
        "### 使用 RunnableParallel 同时从多个知识源检索，然后合并结果。"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# 创建细分知识库的多个检索器\n",
        "tech_docs = [d for d in knowledge_base if d.metadata.get(\"topic\") in [\"LangChain\", \"LCEL\", \"RAG\"]]\n",
        "infra_docs = [d for d in knowledge_base if d.metadata.get(\"topic\") in [\"Vector Database\", \"Embeddings\", \"Production\"]]\n",
        "\n",
        "tech_retriever = MockRetriever(tech_docs)\n",
        "infra_retriever = MockRetriever(infra_docs)\n",
        "\n",
        "\n",
        "def merge_docs(doc_lists: list[list[Document]]) -> list[Document]:\n",
        "    \"\"\"合并多个检索来源的文档，去重并保留来源信息。\"\"\"\n",
        "    seen_content = set()\n",
        "    merged = []\n",
        "    for doc_list in doc_lists:\n",
        "        for doc in doc_list:\n",
        "            content_hash = doc.page_content[:100]\n",
        "            if content_hash not in seen_content:\n",
        "                seen_content.add(content_hash)\n",
        "                merged.append(doc)\n",
        "    return merged\n",
        "\n",
        "\n",
        "# 并行多渠道检索\n",
        "multi_source_retrieval = RunnableParallel(\n",
        "    tech_results=RunnableLambda(lambda q: tech_retriever.invoke(q)),\n",
        "    infra_results=RunnableLambda(lambda q: infra_retriever.invoke(q)),\n",
        ")\n",
        "\n",
        "# 测试\n",
        "query = \"向量数据库和LangChain\"\n",
        "parallel_results = multi_source_retrieval.invoke(query)\n",
        "\n",
        "print(f\"=== 并行多渠道检索 ===\")\n",
        "print(f\"查询: {query}\")\n",
        "print(f\"技术知识库: {len(parallel_results['tech_results'])} 个文档\")\n",
        "print(f\"基础设施库: {len(parallel_results['infra_results'])} 个文档\")\n",
        "\n",
        "# 合并文档\n",
        "all_docs = merge_docs([\n",
        "    parallel_results['tech_results'],\n",
        "    parallel_results['infra_results'],\n",
        "])\n",
        "print(f\"合并去重后: {len(all_docs)} 个文档\")\n",
        "for doc in all_docs:\n",
        "    print(f\"  - [{doc.metadata['topic']}] {doc.page_content[:60]}...\")"
      ],
