        "    MessagesPlaceholder(variable_name=\"chat_history\"),\n",
        "    (\"human\", \"最新问题: {question}\\n独立问题:\"),\n",
        "])\n",
        "\n",
        "# 上下文化问题链\n",
        "contextualize_q_chain = contextualize_q_prompt | model | StrOutputParser()\n",
        "\n",
        "# 测试\n",
        "test_history = [\n",
        "    HumanMessage(content=\"什么是RAG？\"),\n",
