        "import statistics\n",
        "\n",
        "\n",
        "def benchmark_pipelines(queries: list[str], iterations: int = 3) -> dict:\n",
        "    \"\"\"对比自定义管道和 LCEL 管道的性能。\"\"\"\n",
        "    custom_times = []\n",
        "    lcel_times = []\n",
        "    \n",
        "    for query in queries:\n",
        "        for _ in range(iterations):\n",
        "            # 自定义管道\n",
        "            t0 = time.time()\n",
        "            custom_pipeline.run(query)\n",
        "            custom_times.append(time.time() - t0)\n",
        "            \n",
        "            # LCEL 管道\n",
        "            t0 = time.time()\n",
        "            full_rag_chain.invoke(query)\n",
        "            lcel_times.append(time.time() - t0)\n",
        "    \n",
        "    return {\n",
        "        \"custom\": {\n",
        "            \"mean\": statistics.mean(custom_times),\n",
        "            \"stdev\": statistics.stdev(custom_times) if len(custom_times) > 1 else 0,\n",
        "            \"min\": min(custom_times),\n",
        "            \"max\": max(custom_times),\n",
        "        },\n",
        "        \"lcel\": {\n",
        "            \"mean\": statistics.mean(lcel_times),\n",
        "            \"stdev\": statistics.stdev(lcel_times) if len(lcel_times) > 1 else 0,\n",
        "            \"min\": min(lcel_times),\n",
        "            \"max\": max(lcel_times),\n",
        "        },\n",
        "    }\n",
