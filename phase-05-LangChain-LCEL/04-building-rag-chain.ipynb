        "### 2.1 自定义实现（模拟第03阶段代码风格）\n",
        "\n",
        "以下是第03阶段可能的手动 RAG 实现风格——每个步骤都需要显式管理中间结果："
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# ============================================\n",
        "# 第03阶段风格：手动实现 RAG（计行数）\n",
        "# ============================================\n",
        "\n",
        "# 标记：以下代码模拟第03阶段的全手动实现\n",
        "# --- 第03阶段代码开始 ---\n",
        "\n",
        "class CustomRAGPipeline:\n",
        "    \"\"\"手动实现 RAG 管道（第03阶段风格）。\n",
        "    \n",
        "    所有步骤都需要显式管理：\n",
        "    - 手动调用每个组件的 invoke\n",
        "    - 手动管理中间变量\n",
        "    - 手动组装最终答案\n",
        "    \"\"\"\n",
        "    \n",
        "    def __init__(self, retriever, model, prompt_template):\n",
        "        self.retriever = retriever\n",
        "        self.model = model\n",
        "        self.prompt_template = prompt_template\n",
        "    \n",
        "    def retrieve_documents(self, query: str) -> list[Document]:\n",
        "        \"\"\"步骤1：检索文档。\"\"\"\n",
        "        docs = self.retriever.get_relevant_documents(query)\n",
        "        return docs\n",
        "    \n",
        "    def format_retrieved_docs(self, docs: list[Document]) -> str:\n",
        "        \"\"\"步骤2：格式化检索结果。\"\"\"\n",
        "        formatted_parts = []\n",
        "        for i, doc in enumerate(docs):\n",
        "            source = doc.metadata.get(\"source\", \"未知来源\")\n",
        "            formatted_parts.append(\n",
        "                f\"[文档{i+1} 来源: {source}]\\n{doc.page_content}\\n\"\n",
        "            )\n",
        "        return \"\\n---\\n\".join(formatted_parts)\n",
        "    \n",
        "    def build_prompt(self, context: str, question: str) -> str:\n",
        "        \"\"\"步骤3：构建提示。\"\"\"\n",
        "        prompt = (\n",
        "            \"你是一个基于文档回答问题的助手。\\n\"\n",
        "            \"请仅根据以下上下文回答问题，不要编造信息。\\n\\n\"\n",
        "            f\"上下文：\\n{context}\\n\\n\"\n",
        "            f\"问题：{question}\\n\\n\"\n",
        "            \"回答：\"\n",
        "        )\n",
        "        return prompt\n",
        "    \n",
        "    def generate(self, prompt: str) -> str:\n",
        "        \"\"\"步骤4：生成回答。\"\"\"\n",
        "        from langchain_core.messages import HumanMessage\n",
        "        messages = [HumanMessage(content=prompt)]\n",
        "        result = self.model.invoke(messages)\n",
        "        return result.content\n",
        "    \n",
        "    def run(self, question: str) -> dict:\n",
        "        \"\"\"步骤5：运行完整管道。\"\"\"\n",
        "        # 手动每一步\n",
        "        docs = self.retrieve_documents(question)\n",
        "        context = self.format_retrieved_docs(docs)\n",
        "        prompt = self.build_prompt(context, question)\n",
        "        answer = self.generate(prompt)\n",
        "        \n",
        "        return {\n",
        "            \"question\": question,\n",
        "            \"answer\": answer,\n",
        "            \"source_documents\": docs,\n",
        "            \"context\": context,\n",
        "        }\n",
        "\n",
        "# --- 第03阶段代码结束 ---\n",
        "\n",
        "\n",
        "# 统计代码行数\n",
        "custom_code_lines = 56  # 包括类定义和所有方法\n",
