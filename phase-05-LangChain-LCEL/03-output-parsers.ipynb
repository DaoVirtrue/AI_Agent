    "---\\n",
    "## 5. EnumOutputParser - 枚举输出解析器\\n",
    "\\n",
    "**将 LLM 输出匹配到预定义的枚举值。**\\n",
    "- 自动处理大小写、前后空格\\n",
    "- 适用场景：分类、情感分析、意图识别"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# === EnumOutputParser 示例 ===\\n",
    "\\n",
    "class Sentiment(str, Enum):\\n",
    "    POSITIVE = \\\"positive\\\"\\n",
    "    NEGATIVE = \\\"negative\\\"\\n",
    "    NEUTRAL = \\\"neutral\\\"\\n",
    "\\n",
    "class Priority(str, Enum):\\n",
    "    LOW = \\\"low\\\"\\n",
    "    MEDIUM = \\\"medium\\\"\\n",
    "    HIGH = \\\"high\\\"\\n",
    "    CRITICAL = \\\"critical\\\"\\n",
    "\\n",
    "# 情感分析解析器\\n",
    "sentiment_parser = EnumOutputParser(enum=Sentiment)\\n",
    "\\n",
    "print(\\\"=== 情感分析格式说明 ===\\\")\\n",
    "print(sentiment_parser.get_format_instructions())\\n",
    "print()\\n",
    "\\n",
    "# 测试各种输入变体\\n",
    "test_cases = [\\n",
    "    (\\\"POSITIVE\\\", \\\"大写\\\"),\\n",
    "    (\\\"negative\\\", \\\"小写\\\"),\\n",
    "    (\\\" Neutral \\\", \\\"前后空格\\\"),\\n",
    "    (\\\"positive.\\\", \\\"带句号\\\"),\\n",
    "    (\\\"unknown\\\", \\\"无效值（会抛出异常）\\\"),\\n",
    "]\\n",
    "\\n",
    "for text, desc in test_cases:\\n",
    "    try:\\n",
    "        result = sentiment_parser.invoke(text)\\n",
    "        print(f\\\"  输入: '{text}' ({desc})\\\\n  输出: {result} (类型: {type(result).__name__})\\\\n\\\")\\n",
    "    except Exception as e:\\n",
    "        print(f\\\"  输入: '{text}' ({desc})\\\\n  错误: {type(e).__name__}: {e}\\\\n\\\")\\n",
    "\\n",
    "# 优先级解析器\\n",
    "priority_parser = EnumOutputParser(enum=Priority)\\n",
    "print(\\\"=== 优先级解析器 ===\\\")\\n",
    "for val in [\\\"high\\\", \\\"CRITICAL\\\", \\\"medium\\\"]:\\n",
    "    print(f\\\"  '{val}' -> {priority_parser.invoke(val)}\\\")"
   ]
  },
