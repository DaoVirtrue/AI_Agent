    "\\n",
    "# 主解析器\\n",
    "pydantic_parser = PydanticOutputParser(pydantic_object=Product)\\n",
    "\\n",
    "# 带修复功能的解析器\\n",
    "fixing_parser = OutputFixingParser.from_llm(\\n",
    "    parser=pydantic_parser,\\n",
    "    llm=model  # 注意：生产环境需真实LLM\\n",
    ")\\n",
    "\\n",
    "print(\\\"=== OutputFixingParser 创建成功 ===\\\")\\n",
    "print(f\\\"主解析器: {type(pydantic_parser).__name__}\\\")\\n",
    "print(f\\\"修复解析器: {type(fixing_parser).__name__}\\\\")"
