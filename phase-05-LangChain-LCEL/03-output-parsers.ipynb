   "source": [
    "# === 完整的 PydanticOutputParser 管线 ===\\n",
    "\\n",
    "class MovieReview(BaseModel):\\n",
    "    \\\"\\\"\\\"电影评论结构化提取\\\"\\\"\\\"\\n",
    "    title: str = Field(description=\\\"电影名称\\\")\\n",
    "    year: int = Field(description=\\\"上映年份\\\")\\n",
    "    rating: float = Field(description=\\\"评分 (0.0-10.0)\\\", ge=0.0, le=10.0)\\n",
