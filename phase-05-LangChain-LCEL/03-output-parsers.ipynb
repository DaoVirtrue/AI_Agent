    "    print(f\\\"测试3 - 未触发验证错误: {result3}\\\")\\n",
    "except Exception as e:\\n",
    "    print(f\\\"测试3 - Pydantic验证捕获:\\\\n  错误类型: {type(e).__name__}\\\\n  错误信息: {e}\\\")"
   ]
